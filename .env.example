# Google OAuth (console.cloud.google.com > APIs & Services > Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# NextAuth
NEXTAUTH_SECRET=          # generate with: openssl rand -base64 32
NEXTAUTH_URL=             # e.g. https://your-app.vercel.app (not needed for local dev)

# Comma-separated list of approved field-staff Gmail addresses.
# Leave blank during testing to allow any Google account.
ALLOWED_EMAILS=someone@gmail.com,another@gmail.com

# Comma-separated list of admin Gmail addresses (can access /admin to upload learner sheets).
# Admins are automatically allowed to sign in even if not listed in ALLOWED_EMAILS.
ADMIN_EMAILS=coordinator@gmail.com

# Postgres connection (Vercel Storage -> Create Database -> Postgres).
# Vercel injects these automatically when you link the database to this project —
# you usually don't need to set these by hand except for local development.
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=

# Outbound email (SMTP). Any provider works — Gmail, Zoho, SendGrid SMTP, etc.
# From address should be noreply@seghana.net if your mail provider allows sending as that address.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=noreply@seghana.net
MAIL_TO=merl@seghana.net
